generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  password_hash String
  phone         String?
  city          String?
  state         String?
  avatar        String?
  role          Role              @default(USER)
  isActive      Boolean           @default(true)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         Item[]
  requests      DonationRequest[]
  messages      Message[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Item {
  id          String            @id @default(uuid())
  title       String
  description String
  category    String
  condition   String
  images      String // JSON string
  status      String            @default("AVAILABLE") // AVAILABLE, PENDING, DONATED, RESERVED
  version     Int               @default(1)
  deletedAt   DateTime?
  donorId     String
  donor       User              @relation(fields: [donorId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  requests    DonationRequest[]
}

model DonationRequest {
  id            String    @id @default(uuid())
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   User      @relation(fields: [beneficiaryId], references: [id])
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]
}

model Message {
  id        String          @id @default(uuid())
  content   String
  requestId String
  request   DonationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User            @relation(fields: [senderId], references: [id])
  createdAt DateTime        @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
